# AWS Bedrock Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Optional: Air quality API (IQAir, OpenWeatherMap, etc.)
IQAIR_API_KEY=your-iqair-api-key-here

# Writer API (for Knowledge Graph + MeSH ontology)
WRITER_API_KEY=your-writer-api-key-here
WRITER_GRAPH_ID=mesh-ontology-2025  # From scripts/mesh/03_upload_to_writer.py

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS Settings (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# INDRA Settings
# Network Search API for entity grounding and resolution
INDRA_BASE_URL=https://network.indra.bio
INDRA_TIMEOUT=30
INDRA_CACHE_TTL=3600

# INDRA Database REST API (for statement queries via Python library)
# Public endpoint - no API key required for basic access
INDRA_DB_REST_URL=https://db.indra.bio
INDRA_DB_REST_API_KEY=  # Optional - leave empty for public access

# Agent Settings (AWS Bedrock Model ID)
AGENT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AGENT_TEMPERATURE=0

# MongoDB Settings (healthos_bot only)
MONGODB_PORT=27017
MONGODB_PATH=./mongodb
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=username
MONGO_EXPRESS_PASSWORD=password
